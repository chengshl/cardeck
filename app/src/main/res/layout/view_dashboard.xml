<?xml version="1.0" encoding="utf-8"?>
<!-- Buick E5 iOS27-inspired dashboard media pane.
     The live navigation route belongs to the separate map tile. Do not
     fabricate turn instructions: no navigation-step feed exists here.
     IDs remain compatible with GridActivity's existing media bindings. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Matched wallpaper crop and scrim: supplied by GridActivity. -->
    <ImageView
        android:id="@+id/dashWallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:importantForAccessibility="no" />
    <View
        android:id="@+id/dashScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="5dp"
        android:orientation="vertical">

        <!-- Neutral route/status card; actual guidance stays in map app. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_ios27_glass_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="8dp">
            <ImageView
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:src="@drawable/ic_menu_map"
                android:tint="#F1F6FF"
                android:contentDescription="地图" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="导航"
                    android:textColor="#FFFFFFFF"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:textSize="12sp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="路线详情以地图显示为准"
                    android:textColor="#CBDFEDFF"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:textSize="9sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_ios27_glass_card"
            android:padding="8dp"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_ios27_album_plate">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_music"
                        android:padding="11dp"
                        android:tint="#ECF7FFFF"
                        android:importantForAccessibility="no" />
                    <ImageView
                        android:id="@+id/dashCover"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:visibility="invisible"
                        android:importantForAccessibility="no" />
                </FrameLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="媒体"
                        android:textColor="#BED7ECFF"
                        android:textSize="9sp"
                        android:includeFontPadding="false" />
                    <TextView
                        android:id="@+id/dashMediaTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="未在播放"
                        android:textColor="#FFFFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:includeFontPadding="false" />
                    <TextView
                        android:id="@+id/dashMediaArtist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="媒体信息未连接"
                        android:textColor="#D7E0EDFA"
                        android:textSize="9sp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:includeFontPadding="false" />
                </LinearLayout>
            </LinearLayout>

            <ProgressBar
                android:id="@+id/dashMediaProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="5dp"
                android:max="1000"
                android:progressDrawable="@drawable/bg_media_progress"
                android:visibility="gone" />

            <TextView
                android:id="@+id/dashMediaTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="end"
                android:fontFeatureSettings="tnum"
                android:textColor="#BFDBE8FB"
                android:textSize="9sp"
                android:includeFontPadding="false"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:gravity="center"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/dashPrev"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_media_prev"
                    android:contentDescription="上一首"
                    android:background="?android:attr/selectableItemBackgroundBorderless" />
                <ImageView
                    android:id="@+id/dashPlayPause"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_media_play"
                    android:contentDescription="播放或暂停"
                    android:background="@drawable/bg_ios27_home_button" />
                <ImageView
                    android:id="@+id/dashNext"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_media_next"
                    android:contentDescription="下一首"
                    android:background="?android:attr/selectableItemBackgroundBorderless" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>