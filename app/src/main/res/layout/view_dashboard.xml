<?xml version="1.0" encoding="utf-8"?>
<!-- T59 E5 Dashboard: airy, daylight legible, CarPlay-inspired.
     The map remains a real separate virtual-display tile, not a screenshot.
     No fabricated route/ETA/home/work values are displayed. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <ImageView android:id="@+id/dashWallpaper"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:importantForAccessibility="no" />
    <View android:id="@+id/dashScrim"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <LinearLayout android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="4dp">

        <!-- A working map entry; home/company routing is tracked separately in #10. -->
        <LinearLayout android:id="@+id/dashMapShortcut"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="11dp" android:paddingEnd="8dp"
            android:background="@drawable/bg_e5_daylight_card"
            android:contentDescription="打开默认地图">

            <FrameLayout android:layout_width="30dp" android:layout_height="30dp"
                android:background="@drawable/bg_e5_map_orb">
                <ImageView android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="6dp"
                    android:src="@drawable/ic_menu_map"
                    android:tint="#FFFFFFFF"
                    android:importantForAccessibility="no" />
            </FrameLayout>

            <LinearLayout android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="9dp"
                android:orientation="vertical">
                <TextView android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="地图导航"
                    android:textColor="#FF273348"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false" />
                <TextView android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="路线与路口详情以地图为准"
                    android:textColor="#FF6E7889"
                    android:textSize="9sp" android:maxLines="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false" />
            </LinearLayout>
            <TextView android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:paddingStart="10dp" android:paddingEnd="10dp"
                android:gravity="center"
                android:text="打开"
                android:textSize="11sp" android:textStyle="bold"
                android:textColor="#FF3B639B"
                android:background="@drawable/bg_e5_daylight_chip" />
        </LinearLayout>

        <LinearLayout android:id="@+id/dashMediaCard"
            android:layout_width="match_parent"
            android:layout_height="0dp" android:layout_weight="1"
            android:layout_marginTop="6dp"
            android:paddingStart="12dp" android:paddingEnd="12dp"
            android:paddingTop="8dp" android:paddingBottom="7dp"
            android:background="@drawable/bg_e5_daylight_card"
            android:orientation="vertical">

            <TextView android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="正在播放"
                android:textColor="#FF737F90"
                android:textSize="10sp" android:textStyle="bold"
                android:includeFontPadding="false" />

            <LinearLayout android:layout_width="match_parent"
                android:layout_height="0dp" android:layout_weight="1"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <FrameLayout android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:background="@drawable/bg_ios27_album_plate">
                    <ImageView android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_music"
                        android:tint="#FFFFFFFF" android:padding="20dp"
                        android:importantForAccessibility="no" />
                    <ImageView android:id="@+id/dashCover"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:visibility="invisible"
                        android:importantForAccessibility="no" />
                </FrameLayout>
                <LinearLayout android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="11dp"
                    android:orientation="vertical">
                    <TextView android:id="@+id/dashMediaTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="未在播放"
                        android:textColor="#FF273348"
                        android:textSize="15sp" android:textStyle="bold"
                        android:maxLines="2" android:ellipsize="end"
                        android:includeFontPadding="false" />
                    <TextView android:id="@+id/dashMediaArtist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="#FF657389"
                        android:textSize="11sp" android:maxLines="2"
                        android:ellipsize="end"
                        android:includeFontPadding="false" />
                </LinearLayout>
            </LinearLayout>

            <ProgressBar android:id="@+id/dashMediaProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="5dp"
                android:max="1000"
                android:progressDrawable="@drawable/bg_e5_daylight_progress"
                android:visibility="gone" />

            <TextView android:id="@+id/dashMediaTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="#FF79859A"
                android:textSize="9sp"
                android:fontFeatureSettings="tnum"
                android:gravity="end"
                android:visibility="gone"
                android:includeFontPadding="false" />

            <LinearLayout android:layout_width="match_parent"
                android:layout_height="35dp"
                android:layout_marginTop="5dp"
                android:orientation="horizontal"
                android:gravity="center">
                <ImageView android:id="@+id/dashPrev"
                    android:layout_width="37dp" android:layout_height="35dp"
                    android:padding="10dp"
                    android:src="@drawable/ic_media_prev"
                    android:tint="#FF25344C"
                    android:contentDescription="上一首"
                    android:background="?android:attr/selectableItemBackgroundBorderless" />
                <ImageView android:id="@+id/dashPlayPause"
                    android:layout_width="40dp" android:layout_height="35dp"
                    android:layout_marginStart="11dp" android:layout_marginEnd="11dp"
                    android:padding="9dp"
                    android:src="@drawable/ic_media_play"
                    android:tint="#FF25344C"
                    android:contentDescription="播放或暂停"
                    android:background="@drawable/bg_e5_daylight_chip" />
                <ImageView android:id="@+id/dashNext"
                    android:layout_width="37dp" android:layout_height="35dp"
                    android:padding="10dp"
                    android:src="@drawable/ic_media_next"
                    android:tint="#FF25344C"
                    android:contentDescription="下一首"
                    android:background="?android:attr/selectableItemBackgroundBorderless" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>