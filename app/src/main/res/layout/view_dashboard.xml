<?xml version="1.0" encoding="utf-8"?>
<!-- Buick E5 T58: balanced CarPlay-style music card. Live navigation stays in map tile.
     Preserve all existing dash* view IDs for MediaSessionsState and media key actions. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <ImageView
        android:id="@+id/dashWallpaper"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:importantForAccessibility="no" />
    <View android:id="@+id/dashScrim"
        android:layout_width="match_parent" android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="6dp">

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="46dp"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:background="@drawable/bg_ios27_glass_card"
            android:paddingStart="11dp" android:paddingEnd="10dp">
            <ImageView
                android:layout_width="25dp" android:layout_height="25dp"
                android:src="@drawable/ic_menu_map"
                android:tint="#F4F8FF" android:contentDescription="导航" />
            <LinearLayout
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="9dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="导航" android:textStyle="bold" android:textSize="13sp"
                    android:textColor="#FFFFFFFF" android:includeFontPadding="false" />
                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="2dp" android:text="路线请查看左侧地图"
                    android:textSize="10sp" android:textColor="#C7E6EBFF"
                    android:maxLines="1" android:ellipsize="end"
                    android:includeFontPadding="false" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:layout_marginTop="7dp"
            android:background="@drawable/bg_ios27_glass_card"
            android:paddingStart="13dp" android:paddingEnd="13dp"
            android:paddingTop="12dp" android:paddingBottom="9dp"
            android:gravity="center_vertical" android:orientation="vertical">

            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="音乐" android:textColor="#DBE5F5FF"
                android:textStyle="bold" android:textSize="11sp"
                android:includeFontPadding="false" />

            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:gravity="center_vertical"
                android:orientation="horizontal">
                <FrameLayout
                    android:layout_width="82dp" android:layout_height="82dp"
                    android:background="@drawable/bg_ios27_album_plate">
                    <ImageView
                        android:layout_width="match_parent" android:layout_height="match_parent"
                        android:src="@drawable/ic_music" android:tint="#EDF5FFFF"
                        android:padding="24dp" android:importantForAccessibility="no" />
                    <ImageView
                        android:id="@+id/dashCover"
                        android:layout_width="match_parent" android:layout_height="match_parent"
                        android:scaleType="centerCrop" android:visibility="invisible"
                        android:importantForAccessibility="no" />
                </FrameLayout>
                <LinearLayout
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="12dp"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/dashMediaTitle"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="未在播放" android:textColor="#FFFFFFFF"
                        android:textSize="16sp" android:textStyle="bold"
                        android:maxLines="2" android:ellipsize="end"
                        android:includeFontPadding="false" />
                    <TextView
                        android:id="@+id/dashMediaArtist"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" android:text="媒体信息未连接"
                        android:textColor="#CDE1EEFF" android:textSize="12sp"
                        android:maxLines="2" android:ellipsize="end"
                        android:includeFontPadding="false" />
                </LinearLayout>
            </LinearLayout>

            <View android:layout_width="1dp" android:layout_height="0dp"
                android:layout_weight="1" />

            <ProgressBar
                android:id="@+id/dashMediaProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="4dp"
                android:layout_marginTop="12dp" android:max="1000"
                android:progressDrawable="@drawable/bg_media_progress"
                android:visibility="gone" />

            <TextView
                android:id="@+id/dashMediaTime"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="5dp" android:gravity="end"
                android:textSize="10sp" android:textColor="#C6D7E8FB"
                android:fontFeatureSettings="tnum" android:visibility="gone"
                android:includeFontPadding="false" />

            <LinearLayout
                android:layout_width="match_parent" android:layout_height="48dp"
                android:layout_marginTop="7dp" android:gravity="center"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/dashPrev"
                    android:layout_width="44dp" android:layout_height="44dp"
                    android:padding="12dp" android:src="@drawable/ic_media_prev"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="上一首" />
                <ImageView
                    android:id="@+id/dashPlayPause"
                    android:layout_width="48dp" android:layout_height="48dp"
                    android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
                    android:padding="12dp" android:src="@drawable/ic_media_play"
                    android:background="@drawable/bg_ios27_home_button"
                    android:contentDescription="播放或暂停" />
                <ImageView
                    android:id="@+id/dashNext"
                    android:layout_width="44dp" android:layout_height="44dp"
                    android:padding="12dp" android:src="@drawable/ic_media_next"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="下一首" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>