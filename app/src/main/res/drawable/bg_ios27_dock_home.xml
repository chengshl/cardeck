<?xml version="1.0" encoding="utf-8"?>
<!-- Smaller iOS-style selected Dock capsule; 42dp touch bounds unchanged. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="8dp" android:insetRight="8dp"
    android:insetTop="8dp" android:insetBottom="8dp">
    <shape android:shape="rectangle">
        <solid android:color="#50DDEAFF"/>
        <stroke android:width="0.5dp" android:color="#83E6F0FF"/>
        <corners android:radius="12dp"/>
    </shape>
</inset>