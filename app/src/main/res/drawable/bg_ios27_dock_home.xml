<?xml version="1.0" encoding="utf-8"?>
<!-- Crisp Dock Home capsule. ~42dp tappable area unchanged. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="7dp" android:insetRight="7dp"
    android:insetTop="7dp" android:insetBottom="7dp">
    <shape android:shape="rectangle">
        <solid android:color="#3CFFFFFF" />
        <stroke android:width="0.6dp" android:color="#88FFFFFF" />
        <corners android:radius="14dp" />
    </shape>
</inset>