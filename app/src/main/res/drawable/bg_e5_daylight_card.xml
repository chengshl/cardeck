<?xml version="1.0" encoding="utf-8"?>
<!-- Soft ivory translucent dashboard card; dynamic alpha via DockPrefs.cardOpacity. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient android:angle="270"
        android:startColor="#F2FFFFFF"
        android:centerColor="#EDEEF1F6"
        android:endColor="#E2E5EBF3" />
    <stroke android:width="0.7dp" android:color="#BCFFFFFF" />
    <corners android:radius="21dp" />
</shape>