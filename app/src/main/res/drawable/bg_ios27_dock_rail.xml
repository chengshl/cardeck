<?xml version="1.0" encoding="utf-8"?>
<!-- Floating Dock menu. Plain transparent colour, NO bitmap Gaussian blur.
     Only this menu capsule is rounded; wallpaper outside stays unaltered. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="4dp" android:insetRight="4dp"
    android:insetTop="5dp" android:insetBottom="5dp">
    <shape android:shape="rectangle">
        <solid android:color="#2415223F" />
        <stroke android:width="0.6dp" android:color="#5AFFFFFF" />
        <corners android:radius="19dp" />
    </shape>
</inset>